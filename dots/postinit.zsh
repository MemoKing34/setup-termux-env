# This file is where you can put your post initilaziton
# settings. This file should be on $ZSH_CUSTOM folder
# because these are run at the and by oh-my-zsh

export PATH="$PATH:$HOME/.local/bin"
export MANPATH="$MANPATH:$HOME/.local/share/man"

# Some aliases
alias diff='diff --color=always'
# alias ls='lsd -A --color=always'
alias less='less -RNs --use-color'
# alias grep='grep --color=always'
alias jobs='jobs -l'
